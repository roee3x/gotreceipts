{
  "name": "gotreceipts",
  "version": "0.1.1",
  "description": "Merge gate for AI coding agents. No receipt, no merge.",
  "keywords": [
    "merge-gate",
    "quality-gate",
    "ai-agents",
    "coding-agents",
    "git",
    "ci"
  ],
  "license": "MIT",
  "author": "Roee Shkalim",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roee3x/gotreceipts.git"
  },
  "bugs": {
    "url": "https://github.com/roee3x/gotreceipts/issues"
  },
  "homepage": "https://github.com/roee3x/gotreceipts#readme",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "gotreceipts": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "test": "node scripts/run-tests.ts \"test/**/*.test.ts\"",
    "smoke": "node scripts/pack-smoke.ts",
    "gate": "npm run build && node dist/cli.js gate",
    "release": "node scripts/release.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
